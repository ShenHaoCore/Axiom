# 预发环境变量示例：复制为 .env.staging 后填写实际密码与域名。
POSTGRES_PASSWORD=replace-with-a-staging-password
RABBITMQ_PASSWORD=replace-with-a-staging-rabbitmq-password
# 预发默认不创建演示用户，留空即可
DEMO_USER_PASSWORD=

# OpenIddict 证书目录（包含 signing.pfx、encryption.pfx）与证书密码
OPENIDDICT_CERT_DIR=./deploy/certs
OPENIDDICT_CERT_PASSWORD=replace-with-a-certificate-password

# 对外地址：AuthHub issuer 与 Web 回调地址
PUBLIC_AUTH_ISSUER=https://auth.staging.example.com/
PUBLIC_WEB_CALLBACK_URL=https://app.staging.example.com/callback

# 内部服务间地址；内部链路走 HTTP 时 RequireHttpsMetadata 保持 false
INTERNAL_AUTH_URL=http://authhub:8080
INTERNAL_GATEWAY_URL=http://gateway:8080
AUTH_REQUIRE_HTTPS_METADATA=false
OTLP_ENDPOINT=http://otel-collector:4317

# 端口覆盖（可选）
# AUTHHUB_PORT=5101
# GATEWAY_PORT=5100
# NEWS_PORT=5104
# WEB_PORT=3000
