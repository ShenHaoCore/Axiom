@page "{id:guid}"
@model Axiom.Web.Pages.Airports.EditModel
@{
    ViewData["Title"] = Localizer["Airports.Edit.Title"];
    var deleteConfirm = Localizer["Airports.Edit.DeleteConfirm"].Value;
    var airport = Model.Airport;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">@Localizer["Airports.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(airport?.Name ?? Localizer["Airports.Edit.Title"].Value)</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header-main">
        <h1>@(airport?.Name ?? Localizer["Airports.Edit.Title"].Value)</h1>
        <p class="page-description">
            @Localizer["Airports.Edit.Description"]
            @if (airport is not null)
            {
                <span class="text-muted">· @airport.Code · @airport.CountryCode</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-page="/Index">@Localizer["Common.BackToList"]</a>
        <a class="btn btn-outline-primary" asp-page="/Airports/Translations" asp-route-id="@Model.AirportId">@Localizer["Translations.Manage"]</a>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="detail-layout">
    <div class="detail-main">
        <form method="post" asp-route-id="@Model.AirportId" class="card form-card" id="airport-edit-form">
            <input type="hidden" name="ETag" value="@Model.ETag" />

            <div class="form-section">
                <div class="section-heading">
                    <h2>@Localizer["Airports.Edit.FormHeading"]</h2>
                    <p>@Localizer["Airports.Section.IdentityDescription"]</p>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Input.Code" class="form-label">
                            @Localizer["Field.Airport.Code"]<span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="Input.Code" class="form-control" autocomplete="off">
                        <div class="form-text">@Localizer["Airports.Hint.Code"]</div>
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Input.Name" class="form-label">
                            @Localizer["Field.Airport.Name"]<span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="Input.Name" class="form-control">
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.CountryCode" class="form-label">
                            @Localizer["Field.Airport.CountryCode"]<span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="Input.CountryCode" class="form-control" autocomplete="off">
                        <div class="form-text">@Localizer["Airports.Hint.CountryCode"]</div>
                        <span asp-validation-for="Input.CountryCode" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Input.City" class="form-label"></label>
                        <input asp-for="Input.City" class="form-control">
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-heading">
                    <h2>@Localizer["Airports.Section.Location"]</h2>
                    <p>@Localizer["Airports.Hint.Location"]</p>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Input.Latitude" class="form-label"></label>
                        <input asp-for="Input.Latitude" class="form-control" step="any">
                        <span asp-validation-for="Input.Latitude" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Longitude" class="form-label"></label>
                        <input asp-for="Input.Longitude" class="form-control" step="any">
                        <span asp-validation-for="Input.Longitude" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
                <a class="btn btn-outline-secondary" asp-page="/Index">@Localizer["Common.Cancel"]</a>
            </div>
        </form>
    </div>

    <aside class="detail-side">
        @if (airport is not null)
        {
            <div class="card">
                <div class="card-header">@Localizer["Airports.Edit.DetailsHeading"]</div>
                <div class="card-body">
                    <div class="meta-list">
                        <div class="meta-item">
                            <span class="meta-item-label">@Localizer["Airports.Column.Code"]</span>
                            <span class="meta-item-value"><span class="badge-soft">@airport.Code</span></span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-item-label">@Localizer["Airports.Column.Name"]</span>
                            <span class="meta-item-value">@airport.Name</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-item-label">@Localizer["Airports.Column.Country"]</span>
                            <span class="meta-item-value">@airport.CountryCode</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-item-label">@Localizer["Airports.Column.City"]</span>
                            <span class="meta-item-value">@(airport.City ?? "-")</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-item-label">@Localizer["Airports.Column.Latitude"] / @Localizer["Airports.Column.Longitude"]</span>
                            <span class="meta-item-value num">@(airport.Latitude?.ToString() ?? "-"), @(airport.Longitude?.ToString() ?? "-")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card danger-zone">
                <div class="card-header">@Localizer["Common.DangerZone"]</div>
                <div class="card-body">
                    <p class="danger-zone-text">@Localizer["Common.DeleteWarning"]</p>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.AirportId"
                          id="airport-delete-form" data-confirm="@deleteConfirm">
                        <input type="hidden" name="ETag" value="@Model.ETag" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Common.Delete"]</button>
                    </form>
                </div>
            </div>
        }
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
