@page
@model ErrorModel
@{
    ViewData["Title"] = Localizer["Error.Title"];
}

<h1 class="text-danger">@Localizer["Error.Heading"]</h1>
<h2 class="text-danger">@Localizer["Error.Message"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["Error.DevelopmentMode"]</h3>
<p>@Localizer["Error.DevelopmentDetail"]</p>
<p>
    <strong>@Localizer["Error.DevelopmentWarningTitle"]</strong>
    @Localizer["Error.DevelopmentWarning"]
</p>
