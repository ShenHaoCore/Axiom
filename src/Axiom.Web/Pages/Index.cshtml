@page
@model IndexModel
@{
    ViewData["Title"] = Localizer["Airports.Title"];
}

<div class="page-header">
    <h1>@Localizer["Airports.Title"]</h1>
    <a class="btn btn-primary" asp-page="/Airports/Create">@Localizer["Airports.CreateHeading"]</a>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<section aria-labelledby="airport-list-title">
    <h2 class="h4" id="airport-list-title">@Localizer["Airports.ListHeading"]</h2>
    <div class="table-responsive card table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Airports.Column.Code"]</th>
                    <th scope="col">@Localizer["Airports.Column.Name"]</th>
                    <th scope="col">@Localizer["Airports.Column.Country"]</th>
                    <th scope="col">@Localizer["Airports.Column.City"]</th>
                    <th scope="col">@Localizer["Airports.Column.Latitude"]</th>
                    <th scope="col">@Localizer["Airports.Column.Longitude"]</th>
                    <th scope="col">@Localizer["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var airport in Model.Airports)
                {
                    <tr>
                        <td>@airport.Code</td>
                        <td>@airport.Name</td>
                        <td>@airport.CountryCode</td>
                        <td>@airport.City</td>
                        <td>@airport.Latitude</td>
                        <td>@airport.Longitude</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-page="/Airports/Edit" asp-route-id="@airport.Id">@Localizer["Common.Edit"]</a>
                                <a asp-page="/Airports/Translations" asp-route-id="@airport.Id">@Localizer["Translations.Manage"]</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Airports.Count == 0)
                {
                    <tr><td colspan="7">@Localizer["Airports.Empty"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
