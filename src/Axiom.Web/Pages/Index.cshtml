@page
@model IndexModel
@{
    ViewData["Title"] = Localizer["Airports.Title"];
}

<div class="page-header">
    <div class="page-header-main">
        <h1>@Localizer["Airports.Title"]</h1>
        <p class="page-description">@Localizer["Airports.Description"]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="/Airports/Create">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M8 3v10M3 8h10" />
            </svg>
            @Localizer["Airports.CreateHeading"]
        </a>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<section class="card data-card" aria-labelledby="airport-list-title">
    <div class="card-toolbar">
        <div class="card-toolbar-title">
            <h2 id="airport-list-title">@Localizer["Airports.ListHeading"]</h2>
            <span class="count-pill">@Model.Airports.Count</span>
        </div>
    </div>

    @if (Model.Airports.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
                    <path d="M1.5 8.5 14.5 1.5 8.5 14.5 6 9.5 1.5 8.5Z" />
                </svg>
            </span>
            <p class="empty-state-title">@Localizer["Airports.Empty"]</p>
            <p class="empty-state-text">@Localizer["Airports.EmptyHint"]</p>
            <a class="btn btn-primary btn-sm" asp-page="/Airports/Create">@Localizer["Airports.CreateHeading"]</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Airports.Column.Code"]</th>
                        <th scope="col">@Localizer["Airports.Column.Name"]</th>
                        <th scope="col">@Localizer["Airports.Column.Country"]</th>
                        <th scope="col">@Localizer["Airports.Column.City"]</th>
                        <th scope="col">@Localizer["Airports.Column.Latitude"]</th>
                        <th scope="col">@Localizer["Airports.Column.Longitude"]</th>
                        <th scope="col" class="text-end">@Localizer["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var airport in Model.Airports)
                    {
                        <tr>
                            <td>@airport.Code</td>
                            <td>@airport.Name</td>
                            <td><span class="badge-soft">@airport.CountryCode</span></td>
                            <td class="cell-muted">@airport.City</td>
                            <td class="cell-num">@airport.Latitude</td>
                            <td class="cell-num">@airport.Longitude</td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn btn-ghost" asp-page="/Airports/Edit" asp-route-id="@airport.Id">@Localizer["Common.Edit"]</a>
                                    <a class="btn btn-ghost" asp-page="/Airports/Translations" asp-route-id="@airport.Id">@Localizer["Translations.Manage"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
