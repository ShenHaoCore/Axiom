<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Axiom</title>
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fluid">
    <a class="skip-link" href="#content">@Localizer["Layout.SkipToContent"]</a>
@{
    // 依据当前路径高亮顶部一级导航。
    var path = ViewContext.HttpContext.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var activeNav = path.StartsWith("/news") ? "news"
        : path.StartsWith("/geodivisions") ? "geo-divisions"
        : path.StartsWith("/enums") ? "enums"
        : "airports";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? string.Empty;
    var userInitial = userName.Length > 0 ? userName[..1] : "?";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    // 顶栏按钮显示语言缩写（中文/EN），完整语言名放在下拉菜单里。
    var cultureShort = currentCulture.StartsWith("zh", StringComparison.OrdinalIgnoreCase)
        ? "中文"
        : currentCulture.Split('-')[0].ToUpperInvariant();
}
    @* Tabler 预览同款壳：顶部品牌栏（语言/用户）+ 横向主导航（分组下拉、active 下划线）+ page-wrapper。 *@
    <header class="navbar navbar-expand-md navbar-light d-print-none border-bottom">
        <div class="container-xl">
            <h1 class="navbar-brand mb-0 lh-1">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2 2 7.5 12 13 22 7.5Z" opacity=".9" />
                    <path d="M2 12.5 12 18 22 12.5" opacity=".55" />
                    <path d="M2 17 12 22.5 22 17" opacity=".25" />
                </svg>
                Axiom
            </h1>
            <button class="navbar-toggler d-md-none ms-auto" type="button"
                    data-bs-toggle="collapse" data-bs-target="#topnav-menu"
                    aria-controls="topnav-menu" aria-expanded="false"
                    aria-label="@Localizer["Layout.ToggleNavigation"]">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-nav flex-row align-items-center order-md-2">
                <!-- 界面语言切换：下拉菜单链接（/culture 写 Cookie 后回跳）；切换前由 site.js 检查未保存表单。 -->
                <div class="nav-item dropdown">
                    <a class="btn border shadow-none dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false"
                       aria-label="@Localizer["Culture.Select"]"
                       data-unsaved-message="@Localizer["Layout.UnsavedChanges"]">
                        <span class="nav-link-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                <circle cx="8" cy="8" r="6.5" />
                                <path d="M1.5 8h13M8 1.5c-3.8 4.2-3.8 8.8 0 13M8 1.5c3.8 4.2 3.8 8.8 0 13" />
                            </svg>
                        </span>
                        @cultureShort
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        @foreach (var culture in LocalizationOptions.SupportedCultures)
                        {
                            var cultureResource = Localizer[$"Culture.{culture}"];
                            var cultureName = cultureResource.ResourceNotFound ? culture : cultureResource.Value;
                            <a class="dropdown-item @(culture.Equals(currentCulture, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               href="/culture?culture=@culture&returnUrl=@returnUrl"
                               data-language-link data-unsaved-message="@Localizer["Layout.UnsavedChanges"]">@cultureName</a>
                        }
                    </div>
                </div>
                @if (isAuthenticated)
                {
                    <div class="nav-item dropdown ms-2">
                        <button class="btn border shadow-none d-flex align-items-center gap-2 dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar avatar-sm" aria-hidden="true">@userInitial</span>
                            <span class="d-none d-lg-inline">@userName</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <h6 class="dropdown-header">@userName</h6>
                            <hr class="dropdown-divider" />
                            <form method="post" asp-page="/Account/Logout" class="m-0">
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M6 2H3.5A1.5 1.5 0 0 0 2 3.5v9A1.5 1.5 0 0 0 3.5 14H6" />
                                        <path d="M10.5 5 13.5 8l-3 3M13 8H6.5" />
                                    </svg>
                                    <span>@Localizer["Common.SignOut"]</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            <div class="collapse navbar-collapse ms-md-5 me-md-auto order-md-1" id="topnav-menu">
                <nav class="navbar-nav" aria-label="@Localizer["Layout.Aria.Main"]">
                    <div class="nav-item dropdown @(activeNav != "news" ? "active" : "")">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false"
                           aria-haspopup="true"
                           aria-current="@(activeNav != "news" ? "page" : null)">
                            <span class="nav-link-icon" aria-hidden="true">
                                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                                    <ellipse cx="8" cy="3.5" rx="5.5" ry="2" />
                                    <path d="M2.5 3.5v4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-4" />
                                    <path d="M2.5 7.5v4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-4" />
                                </svg>
                            </span>
                            <span class="nav-link-title">@Localizer["Layout.NavSectionData"]</span>
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item @(activeNav == "airports" ? "active" : "")" asp-page="/Index">@Localizer["Nav.Airports"]</a>
                            <a class="dropdown-item @(activeNav == "geo-divisions" ? "active" : "")" asp-page="/GeoDivisions/Index">@Localizer["Nav.GeoDivisions"]</a>
                            <a class="dropdown-item @(activeNav == "enums" ? "active" : "")" asp-page="/Enums/Index">@Localizer["Nav.Enums"]</a>
                        </div>
                    </div>
                    <div class="nav-item dropdown @(activeNav == "news" ? "active" : "")">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false"
                           aria-haspopup="true"
                           aria-current="@(activeNav == "news" ? "page" : null)">
                            <span class="nav-link-icon" aria-hidden="true">
                                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                                    <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                                    <path d="M4.5 6h4.5M4.5 8.5h7M4.5 11h7" />
                                </svg>
                            </span>
                            <span class="nav-link-title">@Localizer["Layout.NavSectionContent"]</span>
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item @(activeNav == "news" ? "active" : "")" asp-page="/News/Index">@Localizer["Nav.News"]</a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <div class="page-wrapper">
        <main id="content" role="main" class="page-body">
            <div class="container-xl">
                @RenderBody()
            </div>
        </main>
        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl text-center">
                @Localizer["Layout.Footer"]
            </div>
        </footer>
    </div>

    <!-- 通用确认对话框：危险操作与未保存离开提示共用，文本由 site.js 动态填入 -->
    <dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-dialog-title">
        <h2 id="confirm-dialog-title">@Localizer["Common.ConfirmTitle"]</h2>
        <p id="confirm-dialog-text"></p>
        <form method="dialog" class="confirm-dialog-actions">
            <button value="cancel" class="btn btn-outline-secondary" autofocus>@Localizer["Common.Cancel"]</button>
            <button value="confirm" class="btn btn-outline-danger">@Localizer["Common.Confirm"]</button>
        </form>
    </dialog>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
