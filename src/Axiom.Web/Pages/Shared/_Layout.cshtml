<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Axiom</title>
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fluid">
    <a class="skip-link" href="#content">@Localizer["Layout.SkipToContent"]</a>
@{
    // 依据当前路径高亮侧边栏功能模块。
    var path = ViewContext.HttpContext.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var activeNav = path.StartsWith("/news") ? "news"
        : path.StartsWith("/geodivisions") ? "geo-divisions"
        : path.StartsWith("/enums") ? "enums"
        : "airports";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? string.Empty;
    var userInitial = userName.Length > 0 ? userName[..1] : "?";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
    @* Tabler 布局：顶部工具栏（语言/用户） + 垂直侧边栏（品牌/导航） + page-wrapper。 *@
    <header class="navbar navbar-expand-md d-print-none">
        <div class="container-xl">
            <h1 class="navbar-brand mb-0 lh-1 d-md-none">Axiom</h1>
            <div class="ms-auto d-flex align-items-center gap-2">
                <!-- 界面语言切换：只展示语言名；切换前由 site.js 检查未保存表单。 -->
                <form method="get" action="/culture" class="d-flex align-items-center gap-1 m-0">
                    <label class="text-secondary d-none d-md-inline-block pe-1" for="cultureSelect">@Localizer["Culture.UiLabel"]</label>
                    <select id="cultureSelect" name="culture" class="form-select form-select-sm w-auto"
                            aria-label="@Localizer["Culture.Select"]"
                            data-language-select
                            data-unsaved-message="@Localizer["Layout.UnsavedChanges"]">
                        @foreach (var culture in LocalizationOptions.SupportedCultures)
                        {
                            var cultureResource = Localizer[$"Culture.{culture}"];
                            var cultureName = cultureResource.ResourceNotFound ? culture : cultureResource.Value;
                            <option value="@culture" selected="@(culture.Equals(currentCulture, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@cultureName</option>
                        }
                    </select>
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                </form>
                @if (isAuthenticated)
                {
                    <div class="nav-item dropdown">
                        <button class="btn d-flex align-items-center gap-2 dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar avatar-sm" aria-hidden="true">@userInitial</span>
                            <span class="d-none d-lg-inline">@userName</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <h6 class="dropdown-header">@userName</h6>
                            <hr class="dropdown-divider" />
                            <form method="post" asp-page="/Account/Logout" class="m-0">
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M6 2H3.5A1.5 1.5 0 0 0 2 3.5v9A1.5 1.5 0 0 0 3.5 14H6" />
                                        <path d="M10.5 5 13.5 8l-3 3M13 8H6.5" />
                                    </svg>
                                    <span>@Localizer["Common.SignOut"]</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="page">
        <aside class="navbar navbar-vertical navbar-expand-md">
            <div class="container-xl">
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
                        aria-controls="sidebar-menu" aria-expanded="false"
                        aria-label="@Localizer["Layout.ToggleNavigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand navbar-brand-autodark d-none d-md-inline-flex" asp-page="/Index">
                    Axiom
                </a>
                <div class="collapse navbar-collapse" id="sidebar-menu">
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-category">@Localizer["Layout.NavSectionData"]</li>
                        <li class="nav-item @(activeNav == "airports" ? "active" : "")">
                            <a class="nav-link" asp-page="/Index" aria-current="@(activeNav == "airports" ? "page" : null)">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                                        <path d="M1.5 8.5 14.5 1.5 8.5 14.5 6 9.5 1.5 8.5Z" />
                                    </svg>
                                </span>
                                <span class="nav-link-title">@Localizer["Nav.Airports"]</span>
                            </a>
                        </li>
                        <li class="nav-item @(activeNav == "geo-divisions" ? "active" : "")">
                            <a class="nav-link" asp-page="/GeoDivisions/Index" aria-current="@(activeNav == "geo-divisions" ? "page" : null)">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                        <circle cx="8" cy="8" r="6.5" />
                                        <path d="M1.5 8h13M8 1.5c-3.8 4.2-3.8 8.8 0 13M8 1.5c3.8 4.2 3.8 8.8 0 13" />
                                    </svg>
                                </span>
                                <span class="nav-link-title">@Localizer["Nav.GeoDivisions"]</span>
                            </a>
                        </li>
                        <li class="nav-item @(activeNav == "enums" ? "active" : "")">
                            <a class="nav-link" asp-page="/Enums/Index" aria-current="@(activeNav == "enums" ? "page" : null)">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                        <path d="M2.5 3.5h11M2.5 8h11M2.5 12.5h7" />
                                    </svg>
                                </span>
                                <span class="nav-link-title">@Localizer["Nav.Enums"]</span>
                            </a>
                        </li>
                        <li class="nav-category">@Localizer["Layout.NavSectionContent"]</li>
                        <li class="nav-item @(activeNav == "news" ? "active" : "")">
                            <a class="nav-link" asp-page="/News/Index" aria-current="@(activeNav == "news" ? "page" : null)">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                                        <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                                        <path d="M4.5 6h4.5M4.5 8.5h7M4.5 11h7" />
                                    </svg>
                                </span>
                                <span class="nav-link-title">@Localizer["Nav.News"]</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>
        <div class="page-wrapper">
            <main id="content" role="main" class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </main>
            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl text-center">
                    @Localizer["Layout.Footer"]
                </div>
            </footer>
        </div>
    </div>

    <!-- 通用确认对话框：危险操作与未保存离开提示共用，文本由 site.js 动态填入 -->
    <dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-dialog-title">
        <h2 id="confirm-dialog-title">@Localizer["Common.ConfirmTitle"]</h2>
        <p id="confirm-dialog-text"></p>
        <form method="dialog" class="confirm-dialog-actions">
            <button value="cancel" class="btn btn-outline-secondary" autofocus>@Localizer["Common.Cancel"]</button>
            <button value="confirm" class="btn btn-outline-danger">@Localizer["Common.Confirm"]</button>
        </form>
    </dialog>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
