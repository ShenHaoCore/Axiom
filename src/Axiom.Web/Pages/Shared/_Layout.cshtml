<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Axiom</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Axiom.Web.styles.css" asp-append-version="true" />
</head>
<body>
@{
    // 依据当前路径高亮侧边栏导航项。
    var path = ViewContext.HttpContext.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var activeNav = path.StartsWith("/news") ? "news"
        : path.StartsWith("/regions") ? "regions"
        : "airports";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? string.Empty;
    var userInitial = userName.Length > 0 ? userName[..1] : "?";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var currentFlagId = currentCulture.Equals("zh-CN", StringComparison.OrdinalIgnoreCase) ? "flag-zh-cn" : "flag-en";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!-- 使用内联 SVG 国旗，避免 Windows 无法渲染国旗 emoji。 -->
<svg class="culture-flag-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
        <path id="culture-flag-star" d="M0 -1 L0.2245 -0.309 L0.9511 -0.309 L0.3633 0.118 L0.5878 0.809 L0 0.382 L-0.5878 0.809 L-0.3633 0.118 L-0.9511 -0.309 L-0.2245 -0.309 Z" />
        <symbol id="flag-zh-cn" viewBox="0 0 30 20">
            <rect width="30" height="20" fill="#de2910" />
            <g fill="#ffde00">
                <use href="#culture-flag-star" transform="translate(5 5) scale(3)" />
                <use href="#culture-flag-star" transform="translate(10 2) rotate(239.04)" />
                <use href="#culture-flag-star" transform="translate(12 4) rotate(261.87)" />
                <use href="#culture-flag-star" transform="translate(12 7) rotate(285.95)" />
                <use href="#culture-flag-star" transform="translate(10 9) rotate(308.66)" />
            </g>
        </symbol>
        <symbol id="flag-en" viewBox="0 0 60 40">
            <rect width="60" height="40" fill="#012169" />
            <path d="M0 0 60 40 M60 0 0 40" stroke="#fff" stroke-width="8" />
            <path d="M0 0 60 40 M60 0 0 40" stroke="#c8102e" stroke-width="4" />
            <path d="M30 0 V40 M0 20 H60" stroke="#fff" stroke-width="12" />
            <path d="M30 0 V40 M0 20 H60" stroke="#c8102e" stroke-width="7" />
        </symbol>
    </defs>
</svg>
<div class="app d-flex">
    <!-- 桌面端侧边栏 -->
    <aside class="sidebar d-none d-md-flex flex-column">
        <a class="sidebar-brand" asp-page="/Index">
            <span class="sidebar-brand-mark" aria-hidden="true">A</span>
            <span class="sidebar-brand-text">Axiom</span>
        </a>
        <nav class="sidebar-nav flex-grow-1" aria-label="Main">
            <div class="sidebar-section"><span>@Localizer["Layout.NavSectionData"]</span></div>
            <a class="sidebar-link @(activeNav == "airports" ? "active" : "")" asp-page="/Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <path d="M1.5 8.5 14.5 1.5 8.5 14.5 6 9.5 1.5 8.5Z" />
                </svg>
                <span>@Localizer["Nav.Airports"]</span>
            </a>
            <a class="sidebar-link @(activeNav == "regions" ? "active" : "")" asp-page="/Regions/Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.5" />
                    <path d="M1.5 8h13M8 1.5c-3.8 4.2-3.8 8.8 0 13M8 1.5c3.8 4.2 3.8 8.8 0 13" />
                </svg>
                <span>@Localizer["Nav.Regions"]</span>
            </a>
            <div class="sidebar-section"><span>@Localizer["Layout.NavSectionContent"]</span></div>
            <a class="sidebar-link @(activeNav == "news" ? "active" : "")" asp-page="/News/Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                    <path d="M4.5 6h4.5M4.5 8.5h7M4.5 11h7" />
                </svg>
                <span>@Localizer["Nav.News"]</span>
            </a>
        </nav>
    </aside>
    <div class="app-main">
        <header class="topbar d-flex align-items-center">
            <button class="topbar-toggler" type="button" id="navToggle"
                    aria-label="@Localizer["Layout.ToggleNavigation"]">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M2 4h12M2 8h12M2 12h12" />
                </svg>
            </button>
            <span class="topbar-brand d-md-none">Axiom</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <!-- 语言菜单：保留原 /culture 切换逻辑，并展示当前语言国旗。 -->
                <div class="dropdown">
                    <button class="topbar-language-btn dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="@Localizer["Culture.Select"]">
                        <svg class="culture-flag" viewBox="0 0 60 40" aria-hidden="true">
                            <use href="@($"#{currentFlagId}")" />
                        </svg>
                        <span>@Localizer[$"Culture.{currentCulture}"]</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end culture-menu">
                        @foreach (var culture in LocalizationOptions.SupportedCultures)
                        {
                            var flagId = culture.Equals("zh-CN", StringComparison.OrdinalIgnoreCase) ? "flag-zh-cn" : "flag-en";
                            var cultureUrl = $"/culture?culture={Uri.EscapeDataString(culture)}&returnUrl={Uri.EscapeDataString(returnUrl)}";
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 @(culture == currentCulture ? "active" : "")"
                                   href="@cultureUrl"
                                   aria-current="@(culture == currentCulture ? "true" : null)">
                                    <svg class="culture-flag" viewBox="0 0 60 40" aria-hidden="true">
                                        <use href="@($"#{flagId}")" />
                                    </svg>
                                    <span>@Localizer[$"Culture.{culture}"]</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                @if (isAuthenticated)
                {
                    <!-- 用户菜单：展示当前用户并提供退出登录 -->
                    <div class="dropdown">
                        <button class="topbar-user-btn dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar" aria-hidden="true">@userInitial</span>
                            <span class="topbar-user">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@userName</h6></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Account/Logout" class="m-0">
                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M6 2H3.5A1.5 1.5 0 0 0 2 3.5v9A1.5 1.5 0 0 0 3.5 14H6" />
                                            <path d="M10.5 5 13.5 8l-3 3M13 8H6.5" />
                                        </svg>
                                        <span>@Localizer["Common.SignOut"]</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </header>
        <main role="main" class="content">
            <div class="content-inner">
                @RenderBody()
            </div>
        </main>
        <footer class="footer">
            @Localizer["Layout.Footer"]
        </footer>
    </div>
</div>

<!-- 移动端抽屉导航 -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="mobileNavLabel">
            <span class="sidebar-brand-mark me-2" aria-hidden="true">A</span>Axiom
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <nav aria-label="Mobile">
            <div class="sidebar-section"><span>@Localizer["Layout.NavSectionData"]</span></div>
            <a class="sidebar-link @(activeNav == "airports" ? "active" : "")" asp-page="/Index" data-bs-dismiss="offcanvas">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <path d="M1.5 8.5 14.5 1.5 8.5 14.5 6 9.5 1.5 8.5Z" />
                </svg>
                <span>@Localizer["Nav.Airports"]</span>
            </a>
            <a class="sidebar-link @(activeNav == "regions" ? "active" : "")" asp-page="/Regions/Index" data-bs-dismiss="offcanvas">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.5" />
                    <path d="M1.5 8h13M8 1.5c-3.8 4.2-3.8 8.8 0 13M8 1.5c3.8 4.2 3.8 8.8 0 13" />
                </svg>
                <span>@Localizer["Nav.Regions"]</span>
            </a>
            <div class="sidebar-section"><span>@Localizer["Layout.NavSectionContent"]</span></div>
            <a class="sidebar-link @(activeNav == "news" ? "active" : "")" asp-page="/News/Index" data-bs-dismiss="offcanvas">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                    <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                    <path d="M4.5 6h4.5M4.5 8.5h7M4.5 11h7" />
                </svg>
                <span>@Localizer["Nav.News"]</span>
            </a>
        </nav>
    </div>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
