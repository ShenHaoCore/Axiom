<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Axiom</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Axiom.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Axiom</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">@Localizer["Nav.Airports"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/News/Index">@Localizer["Nav.News"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Regions/Index">@Localizer["Nav.Regions"]</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <form method="get" action="/culture" class="m-0">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <select name="culture" class="form-select form-select-sm"
                                    aria-label="@Localizer["Culture.Select"]"
                                    onchange="this.form.submit()">
                                @foreach (var culture in LocalizationOptions.SupportedCultures)
                                {
                                    <option value="@culture" selected="@(culture == System.Globalization.CultureInfo.CurrentUICulture.Name)">
                                        @Localizer[$"Culture.{culture}"]
                                    </option>
                                }
                            </select>
                        </form>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text">@User.Identity.Name</span>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">@Localizer["Layout.Footer"]</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
