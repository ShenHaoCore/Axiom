@model Axiom.Web.RegionTreeView
@using Axiom.Web

<div class="region-node">
    <div class="region-row">
        @if (Model.Children.Count > 0)
        {
            <a class="text-decoration-none me-1" data-bs-toggle="collapse"
               href="#node-@Model.Id" role="button" aria-expanded="false">▶</a>
        }
        else
        {
            <span class="me-3 text-muted">•</span>
        }
        <span class="badge me-2" style="background:@LevelColor(Model.Level)">@LevelLabel(Model.Level)</span>
        <a asp-page="/Regions/Detail" asp-route-id="@Model.Id">@Model.Name</a>
        @if (Model.Population.HasValue)
        {
            <span class="text-muted small ms-2">(@Model.Population.Value.ToString("N0"))</span>
        }
    </div>
    @if (Model.Children.Count > 0)
    {
        <div id="node-@Model.Id" class="collapse">
            <div class="region-children border-start ms-3 ps-3 mt-1">
                @foreach (var child in Model.Children)
                {
                    <partial name="_RegionTreeNode" model="child" />
                }
            </div>
        </div>
    }
</div>

@functions {
    static string LevelLabel(int level) =>
        level == 1 ? "国家" : level == 2 ? "省/州" : level == 3 ? "市" : $"L{level}";

    static string LevelColor(int level) =>
        level == 1 ? "#0b3d91" : level == 2 ? "#1a7f4f" : level == 3 ? "#9d3d10" : "#52606d";
}
