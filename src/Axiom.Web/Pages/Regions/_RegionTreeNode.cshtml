@model Axiom.Web.Models.RegionTreeView
@using Axiom.Web.Models

<div class="region-node">
    <div class="region-row">
        @if (Model.Children.Count > 0)
        {
            <a class="region-toggle" data-bs-toggle="collapse"
               href="#node-@Model.Id" role="button" aria-expanded="false" aria-controls="node-@Model.Id" aria-label="@Model.Name">
                <span class="region-chevron" aria-hidden="true">▶</span>
            </a>
        }
        else
        {
            <span class="me-3 text-muted">•</span>
        }
        <span class="badge-soft me-2 @LevelClass(Model.Level)">@LevelLabel(Model.Level)</span>
        <a asp-page="/Regions/Detail" asp-route-id="@Model.Id">@Model.Name</a>
        <a class="ms-2 small" asp-page="/Regions/Edit" asp-route-id="@Model.Id">@Localizer["Common.Edit"]</a>
        @if (Model.Population.HasValue)
        {
            <span class="text-muted small ms-2">(@Model.Population.Value.ToString("N0"))</span>
        }
    </div>
    @if (Model.Children.Count > 0)
    {
        <div id="node-@Model.Id" class="collapse">
            <div class="region-children border-start ms-3 ps-3 mt-1">
                @foreach (var child in Model.Children)
                {
                    <partial name="_RegionTreeNode" model="child" />
                }
            </div>
        </div>
    }
</div>

@functions {
    string LevelLabel(int level) =>
        level is >= 1 and <= 3 ? Localizer[$"Regions.Level.{level}"].Value : $"L{level}";

    static string LevelClass(int level) =>
        level is >= 1 and <= 3 ? $"level-{level}" : "level-default";
}
