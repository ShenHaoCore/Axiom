@page "{id:guid?}"
@model Axiom.Web.Pages.Regions.DetailModel
@{
    ViewData["Title"] = "行政区详情";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Regions/Index">行政区浏览</a></li>
        <li class="breadcrumb-item active">@(Model.Region?.Name ?? "详情")</li>
    </ol>
</nav>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Region is not null)
{
    var r = Model.Region;

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            @r.Name
            @if (r.LocalName is not null)
            {
                <small class="text-muted fw-normal">@r.LocalName</small>
            }
        </h1>
        <a class="btn btn-outline-secondary" asp-page="/Regions/Index"
           asp-route-countryCode="@r.CountryCode">返回层级树</a>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><strong>基本信息</strong></div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">层级</span>
                        <span class="badge text-bg-secondary">@LevelLabel(r.Level)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">代码</span>
                        <code>@r.Code</code>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">国家</span>
                        <span>@r.CountryCode</span>
                    </li>
                    @if (r.Admin1Code is not null)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Admin1 Code</span>
                            <code>@r.Admin1Code</code>
                        </li>
                    }
                    @if (r.AsciiName is not null)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Ascii 名</span>
                            <span>@r.AsciiName</span>
                        </li>
                    }
                    @if (r.GeoNameId.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">GeoNames ID</span>
                            <span>
                                <a href="https://www.geonames.org/@r.GeoNameId" target="_blank" rel="noopener">
                                    @r.GeoNameId
                                </a>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><strong>地理数据</strong></div>
                <ul class="list-group list-group-flush">
                    @if (r.Population.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">人口</span>
                            <span class="fw-semibold">@r.Population.Value.ToString("N0")</span>
                        </li>
                    }
                    @if (r.Latitude.HasValue || r.Longitude.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">经纬度</span>
                            <span>@r.Latitude?.ToString("F4"), @r.Longitude?.ToString("F4")</span>
                        </li>
                    }
                    @if (r.ParentId.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">父节点 ID</span>
                            <code>@r.ParentId.Value.ToString("N")</code>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">记录 ID</span>
                        <code>@r.Id.ToString("N")</code>
                    </li>
                </ul>
            </div>
        </div>
    </div>
}

@functions {
    private static string LevelLabel(int level) =>
        level == 1 ? "国家" : level == 2 ? "省/州" : level == 3 ? "市" : $"L{level}";
}
