@page "{id:guid?}"
@model Axiom.Web.Pages.Regions.DetailModel
@{
    ViewData["Title"] = Localizer["Regions.Detail.Title"];
    var deleteConfirm = Localizer["Regions.Detail.DeleteConfirm"].Value;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Regions/Index">@Localizer["Regions.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Model.Region?.Name ?? Localizer["Common.View"].Value)</li>
    </ol>
</nav>

@if (Model.Region is not null)
{
    var r = Model.Region;

    <div class="page-header">
        <div class="page-header-main">
            <h1>
                @r.Name
                @if (r.LocalName is not null)
                {
                    <small>@r.LocalName</small>
                }
            </h1>
            <p class="page-description">
                @LevelLabel(r.Level) · @r.CountryCode · <code>@r.Code</code>
            </p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" asp-page="/Regions/Index"
               asp-route-countryCode="@r.CountryCode">@Localizer["Regions.Detail.BackToTree"]</a>
            <a class="btn btn-primary" asp-page="/Regions/Edit" asp-route-id="@r.Id">@Localizer["Common.Edit"]</a>
        </div>
    </div>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="detail-layout">
        <div class="detail-main">
            <div class="card">
                <div class="card-header">@Localizer["Regions.Detail.BasicInfo"]</div>
                <div class="card-body">
                    <dl class="detail-list">
                        <div class="detail-row">
                            <dt class="detail-label">@Localizer["Regions.Detail.Level"]</dt>
                            <dd class="detail-value">
                                <span class="badge-soft @(r.Level is >= 1 and <= 3 ? $"level-{r.Level}" : "level-default")">@LevelLabel(r.Level)</span>
                            </dd>
                        </div>
                        <div class="detail-row">
                            <dt class="detail-label">@Localizer["Regions.Detail.Code"]</dt>
                            <dd class="detail-value"><code>@r.Code</code></dd>
                        </div>
                        <div class="detail-row">
                            <dt class="detail-label">@Localizer["Regions.Detail.Country"]</dt>
                            <dd class="detail-value">@r.CountryCode</dd>
                        </div>
                        @if (r.Admin1Code is not null)
                        {
                            <div class="detail-row">
                                <dt class="detail-label">@Localizer["Regions.Detail.Admin1Code"]</dt>
                                <dd class="detail-value"><code>@r.Admin1Code</code></dd>
                            </div>
                        }
                        @if (r.AsciiName is not null)
                        {
                            <div class="detail-row">
                                <dt class="detail-label">@Localizer["Regions.Detail.AsciiName"]</dt>
                                <dd class="detail-value">@r.AsciiName</dd>
                            </div>
                        }
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-header">@Localizer["Regions.Detail.GeoData"]</div>
                <div class="card-body">
                    <dl class="detail-list">
                        @if (r.Population.HasValue)
                        {
                            <div class="detail-row">
                                <dt class="detail-label">@Localizer["Regions.Detail.Population"]</dt>
                                <dd class="detail-value num">@r.Population.Value.ToString("N0")</dd>
                            </div>
                        }
                        @if (r.Latitude.HasValue || r.Longitude.HasValue)
                        {
                            <div class="detail-row">
                                <dt class="detail-label">@Localizer["Regions.Detail.Coordinates"]</dt>
                                <dd class="detail-value num">@r.Latitude?.ToString("F4"), @r.Longitude?.ToString("F4")</dd>
                            </div>
                        }
                        @if (!r.Population.HasValue && !r.Latitude.HasValue && !r.Longitude.HasValue)
                        {
                            <div class="detail-row">
                                <dt class="detail-label">@Localizer["Regions.Detail.Population"]</dt>
                                <dd class="detail-value text-muted">-</dd>
                            </div>
                        }
                    </dl>
                </div>
            </div>

            @if (Model.TranslationsLoaded)
            {
                <div class="card">
                    <div class="card-header">@Localizer["Translations.Title"]</div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Translations" asp-route-id="@r.Id">
                            <input type="hidden" asp-for="TranslationsLoaded" />
                            <p class="text-muted">@Localizer["Translations.Hint"]</p>

                            @foreach (var culture in Model.EditableCultures)
                            {
                                Model.Translations.TryGetValue(culture, out var translation);
                                var cultureResource = Localizer[$"Culture.{culture}"];
                                var cultureName = cultureResource.ResourceNotFound ? culture : cultureResource.Value;

                                <fieldset class="translation-panel">
                                    <legend>@cultureName</legend>
                                    <div class="row g-3">
                                        <div class="col-md-8">
                                            <label class="form-label" for="translation-@(culture)-name">@Localizer["Field.Region.Name"]</label>
                                            <input class="form-control" id="translation-@(culture)-name"
                                                   name="Translations[@culture].Name" value="@translation?.Name" maxlength="200" />
                                        </div>
                                    </div>
                                </fieldset>
                            }

                            <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">@Localizer["Translations.LoadFailed"]</div>
            }
        </div>

        <aside class="detail-side">
            <div class="card">
                <div class="card-header">@Localizer["Regions.Detail.Meta"]</div>
                <div class="card-body">
                    <div class="meta-list">
                        @if (r.GeoNameId.HasValue)
                        {
                            <div class="meta-item">
                                <span class="meta-item-label">@Localizer["Regions.Detail.GeoNameId"]</span>
                                <span class="meta-item-value">
                                    <a href="https://www.geonames.org/@r.GeoNameId" target="_blank" rel="noopener">@r.GeoNameId</a>
                                </span>
                            </div>
                        }
                        @if (r.ParentId.HasValue)
                        {
                            <div class="meta-item">
                                <span class="meta-item-label">@Localizer["Regions.Detail.ParentId"]</span>
                                <span class="meta-item-value"><code>@r.ParentId.Value.ToString("N")</code></span>
                            </div>
                        }
                        <div class="meta-item">
                            <span class="meta-item-label">@Localizer["Regions.Detail.RecordId"]</span>
                            <span class="meta-item-value"><code>@r.Id.ToString("N")</code></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card danger-zone">
                <div class="card-header">@Localizer["Common.DangerZone"]</div>
                <div class="card-body">
                    <p class="danger-zone-text">@Localizer["Common.DeleteWarning"]</p>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id"
                          data-confirm="@deleteConfirm">
                        <input type="hidden" name="CountryCode" value="@r.CountryCode" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Common.Delete"]</button>
                    </form>
                </div>
            </div>
        </aside>
    </div>
}

@functions {
    private string LevelLabel(int level) =>
        level is >= 1 and <= 3 ? Localizer[$"Regions.Level.{level}"].Value : $"L{level}";
}
