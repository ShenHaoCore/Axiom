@page
@model Axiom.Web.Pages.Regions.IndexModel
@{
    ViewData["Title"] = Localizer["Regions.Title"];
}

<div class="page-header">
    <h1 class="mb-0">@Localizer["Regions.Title"]</h1>
    <a class="btn btn-primary" asp-page="/Regions/Create"
       asp-route-countryCode="@Model.SelectedCountryCode">@Localizer["Regions.Create.Title"]</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<!-- 顶部工具栏 -->
<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-md-3">
        <label class="form-label" for="countryCode">@Localizer["Regions.Country"]</label>
        <select class="form-select" id="countryCode" name="countryCode" data-auto-submit>
            <option value="">@Localizer["Regions.SelectCountry"]</option>
            @foreach (var c in Model.Countries)
            {
                <option value="@c.CountryCode" selected="@(Model.SelectedCountryCode == c.CountryCode)">
                    @c.Name (@c.CountryCode)
                </option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <label class="form-label" for="q">@Localizer["Regions.SearchLabel"]</label>
        <div class="input-group">
            <input type="text" class="form-control" id="q" name="q" placeholder="@Localizer["Regions.SearchPlaceholder"]"
                   value="@Model.SearchQuery" />
            <button type="submit" class="btn btn-primary">@Localizer["Common.Search"]</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <a asp-page="/Regions/Index" asp-route-countryCode="@Model.SelectedCountryCode"
                   class="btn btn-outline-secondary">@Localizer["Common.Clear"]</a>
            }
        </div>
    </div>
</form>

<!-- 搜索结果 -->
@if (Model.SearchResults.Count > 0)
{
    <section aria-labelledby="search-title">
        <h2 class="h4 mb-3" id="search-title">
            @Localizer["Regions.SearchResults"] <span class="text-muted">(@Localizer["Regions.SearchTotal", Model.SearchTotalCount])</span>
        </h2>
        <div class="table-responsive card table-card">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Regions.Column.Level"]</th>
                        <th scope="col">@Localizer["Regions.Column.Name"]</th>
                        <th scope="col">@Localizer["Regions.Column.Code"]</th>
                        <th scope="col">@Localizer["Regions.Column.Country"]</th>
                        <th scope="col">@Localizer["Regions.Column.Admin1"]</th>
                        <th scope="col">@Localizer["Regions.Column.Population"]</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.SearchResults)
                    {
                        <tr>
                            <td>
                                @{
                                    var label = r.Level is >= 1 and <= 3
                                        ? Localizer[$"Regions.Level.{r.Level}"].Value
                                        : $"L{r.Level}";
                                    var levelClass = r.Level is >= 1 and <= 3 ? $"level-{r.Level}" : "level-default";
                                }
                                <span class="badge-soft @levelClass">@label</span>
                            </td>
                            <td>@r.Name</td>
                            <td class="text-muted">@r.Code</td>
                            <td>@r.CountryCode</td>
                            <td class="text-muted">@r.Admin1Code</td>
                            <td>@(r.Population?.ToString("N0") ?? "-")</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-page="/Regions/Detail" asp-route-id="@r.Id">@Localizer["Common.View"]</a>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-page="/Regions/Edit" asp-route-id="@r.Id">@Localizer["Common.Edit"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (!string.IsNullOrEmpty(Model.SearchQuery))
{
    <div class="text-muted mb-4">@Localizer["Regions.NoMatch", Model.SearchQuery]</div>
}

<!-- 层级树 -->
@if (Model.Tree is not null)
{
    <section aria-labelledby="tree-title">
        <h2 class="h4 mb-3" id="tree-title">
            @Model.Tree.Name <span class="text-muted">(@Model.Tree.CountryCode)</span> @Localizer["Regions.TreeTitle"]
        </h2>
        <div class="card">
            <div class="card-body">
                <partial name="_RegionTreeNode" model="@Model.Tree" />
            </div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
