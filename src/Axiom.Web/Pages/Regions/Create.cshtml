@page
@model Axiom.Web.Pages.Regions.CreateModel
@{
    ViewData["Title"] = Localizer["Regions.Create.Title"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Regions/Index">@Localizer["Regions.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Regions.Create.Title"]</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header-main">
        <h1>@Localizer["Regions.Create.Title"]</h1>
        <p class="page-description">@Localizer["Regions.Create.Description"]</p>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="section-heading">
            <h2>@Localizer["Regions.Create.SetupHeading"]</h2>
            <p>@Localizer["Regions.Create.SetupHint"]</p>
        </div>
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="region-depth">@Localizer["Field.Region.Depth"]</label>
                <select class="form-select" id="region-depth" name="depth">
                    @foreach (var depth in Enumerable.Range(0, 4))
                    {
                        <option value="@depth" selected="@(Model.Input.Depth == depth)">@DepthLabel(depth)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="region-country-code">@Localizer["Field.Region.CountryCode"]</label>
                <input class="form-control" id="region-country-code" name="countryCode" value="@Model.Input.CountryCode"
                       maxlength="2" autocomplete="off" list="region-countries" placeholder="CN" />
                <datalist id="region-countries">
                    @foreach (var country in Model.Countries)
                    {
                        <option value="@country.CountryCode">@country.Name</option>
                    }
                </datalist>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary">@Localizer["Regions.Create.LoadForm"]</button>
            </div>
        </form>
    </div>
</div>

<form method="post" class="card form-card" id="region-create-form">
    <input type="hidden" asp-for="Input.Depth" />
    <input type="hidden" asp-for="Input.CountryCode" />

    <div class="form-section">
        <div class="section-heading">
            <h2>@Localizer["Regions.Section.Identity"]</h2>
            <p>@Localizer["Regions.Section.IdentityHint"]</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">@Localizer["Regions.Detail.Depth"]</label>
                <input class="form-control" value="@DepthLabel(Model.Input.Depth)" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Regions.Detail.Country"]</label>
                <input class="form-control" value="@Model.Input.CountryCode" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Code" class="form-label">
                    @Localizer["Field.Region.Code"]<span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Input.Code" class="form-control" autocomplete="off" />
                <div class="form-text">@Localizer["Regions.Hint.Code"]</div>
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            @if (Model.Input.Depth > 0)
            {
                <div class="col-md-6">
                    <label asp-for="Input.ParentCode" class="form-label">
                        @Localizer["Field.Region.Parent"]<span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <select asp-for="Input.ParentCode" asp-items="Model.ParentOptions" class="form-select">
                        <option value="">@Localizer["Regions.Form.SelectParent"]</option>
                    </select>
                    <span asp-validation-for="Input.ParentCode" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Type" class="form-label"></label>
                    <select asp-for="Input.Type" class="form-select">
                        <option value="">@Localizer["Regions.Form.TypeDefault"]</option>
                        @foreach (var type in RegionTypeOptions(Model.Input.Depth))
                        {
                            <option value="@type.Value" selected="@(Model.Input.Type == type.Value)">@type.Label</option>
                        }
                    </select>
                    <div class="form-text">@Localizer["Regions.Hint.Type"]</div>
                </div>
            }

            <div class="col-md-6">
                <label asp-for="Input.Name" class="form-label">
                    @Localizer["Field.Region.Name"]<span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.AsciiName" class="form-label"></label>
                <input asp-for="Input.AsciiName" class="form-control" />
                <span asp-validation-for="Input.AsciiName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.LocalName" class="form-label"></label>
                <input asp-for="Input.LocalName" class="form-control" />
                <span asp-validation-for="Input.LocalName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.CodeIso" class="form-label"></label>
                <input asp-for="Input.CodeIso" class="form-control" autocomplete="off" placeholder="CN-11" />
                <span asp-validation-for="Input.CodeIso" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="section-heading">
            <h2>@Localizer["Regions.Section.Geo"]</h2>
            <p>@Localizer["Regions.Section.GeoHint"]</p>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.Latitude" class="form-label"></label>
                <input asp-for="Input.Latitude" class="form-control" step="any" />
                <span asp-validation-for="Input.Latitude" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Longitude" class="form-label"></label>
                <input asp-for="Input.Longitude" class="form-control" step="any" />
                <span asp-validation-for="Input.Longitude" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Population" class="form-label"></label>
                <input asp-for="Input.Population" class="form-control" min="0" />
                <span asp-validation-for="Input.Population" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="/Regions/Index"
           asp-route-countryCode="@Model.Input.CountryCode">@Localizer["Common.Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private string DepthLabel(int depth) =>
        depth is >= 0 and <= 3 ? Localizer[$"Regions.Depth.{depth}"].Value : $"D{depth}";

    // 类型选项按深度给出国别口径（geo_division type）的常见取值；留空由服务端推导默认值。
    private static (string Value, string LabelKey)[] TypeOptions(int depth) => depth switch
    {
        1 =>
        [
            ("province", "Regions.Type.Province"),
            ("municipality", "Regions.Type.Municipality"),
            ("autonomous_region", "Regions.Type.AutonomousRegion"),
            ("sar", "Regions.Type.SpecialAdministrativeRegion"),
            ("state", "Regions.Type.State")
        ],
        2 =>
        [
            ("prefecture_city", "Regions.Type.PrefectureCity"),
            ("prefecture", "Regions.Type.Prefecture"),
            ("autonomous_prefecture", "Regions.Type.AutonomousPrefecture"),
            ("league", "Regions.Type.League"),
            ("city", "Regions.Type.City"),
            ("county", "Regions.Type.County")
        ],
        3 =>
        [
            ("district", "Regions.Type.District"),
            ("county", "Regions.Type.County"),
            ("county_city", "Regions.Type.CountyCity"),
            ("autonomous_county", "Regions.Type.AutonomousCounty"),
            ("banner", "Regions.Type.Banner"),
            ("autonomous_banner", "Regions.Type.AutonomousBanner"),
            ("special_zone", "Regions.Type.SpecialZone"),
            ("forestry_area", "Regions.Type.ForestryArea"),
            ("other", "Regions.Type.Other")
        ],
        _ => []
    };

    private (string Value, string Label)[] RegionTypeOptions(int depth) =>
        TypeOptions(depth)
            .Select(option => (option.Value, Label: Localizer[option.LabelKey].Value))
            .ToArray();
}
