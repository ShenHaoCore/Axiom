@page
@model Axiom.Web.Pages.Regions.CreateModel
@{
    ViewData["Title"] = Localizer["Regions.Create.Title"];
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Regions/Index">@Localizer["Regions.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["Regions.Create.Title"]</li>
    </ol>
</nav>

<h1 class="mb-4">@Localizer["Regions.Create.Title"]</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-md-4">
        <label class="form-label" for="region-level">@Localizer["Field.Region.Level"]</label>
        <select class="form-select" id="region-level" name="level">
            @foreach (var level in Enumerable.Range(1, 3))
            {
                <option value="@level" selected="@(Model.Input.Level == level)">@Localizer[$"Regions.Level.{level}"]</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="region-country-code">@Localizer["Field.Region.CountryCode"]</label>
        <input class="form-control" id="region-country-code" name="countryCode" value="@Model.Input.CountryCode"
               maxlength="2" autocomplete="off" list="region-countries" />
        <datalist id="region-countries">
            @foreach (var country in Model.Countries)
            {
                <option value="@country.CountryCode">@country.Name</option>
            }
        </datalist>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">@Localizer["Regions.Create.LoadForm"]</button>
    </div>
</form>

<form method="post" class="card card-body" id="region-create-form">
    <input type="hidden" asp-for="Input.Level" />
    <input type="hidden" asp-for="Input.CountryCode" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">@Localizer["Field.Region.Level"]</label>
            <input class="form-control" value="@Localizer[$"Regions.Level.{Model.Input.Level}"]" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label">@Localizer["Field.Region.CountryCode"]</label>
            <input class="form-control" value="@Model.Input.CountryCode" readonly />
        </div>
        @if (Model.Input.Level > 1)
        {
            <div class="col-md-6">
                <label asp-for="Input.ParentId" class="form-label"></label>
                <select asp-for="Input.ParentId" asp-items="Model.ParentOptions" class="form-select">
                    <option value="">@Localizer["Regions.Form.SelectParent"]</option>
                </select>
                <span asp-validation-for="Input.ParentId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Admin1Code" class="form-label"></label>
                <input asp-for="Input.Admin1Code" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Admin1Code" class="text-danger"></span>
            </div>
        }
        <div class="col-md-6">
            <label asp-for="Input.Code" class="form-label"></label>
            <input asp-for="Input.Code" class="form-control" autocomplete="off" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.AsciiName" class="form-label"></label>
            <input asp-for="Input.AsciiName" class="form-control" />
            <span asp-validation-for="Input.AsciiName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.LocalName" class="form-label"></label>
            <input asp-for="Input.LocalName" class="form-control" />
            <span asp-validation-for="Input.LocalName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Latitude" class="form-label"></label>
            <input asp-for="Input.Latitude" class="form-control" step="any" />
            <span asp-validation-for="Input.Latitude" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Longitude" class="form-label"></label>
            <input asp-for="Input.Longitude" class="form-control" step="any" />
            <span asp-validation-for="Input.Longitude" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Population" class="form-label"></label>
            <input asp-for="Input.Population" class="form-control" min="0" />
            <span asp-validation-for="Input.Population" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="/Regions/Index"
           asp-route-countryCode="@Model.Input.CountryCode">@Localizer["Common.Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
