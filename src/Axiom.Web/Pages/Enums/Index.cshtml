@page
@model Axiom.Web.Pages.Enums.IndexModel
@{
    ViewData["Title"] = Localizer["Enums.Title"];
}

<div class="page-header d-print-none">
    <div class="row align-items-center g-2">
        <div class="col">
            <div class="page-title">@Localizer["Enums.Title"]</div>
            <div class="page-subtitle text-secondary">@Localizer["Enums.Description"]</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
        <a class="btn btn-primary" asp-page="/Enums/Create" asp-route-category="@Model.Category">@Localizer["Enums.Create"]</a>
    </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="filter-bar">
    <div class="filter-field filter-field-grow">
        <label class="form-label" for="Category">@Localizer["Field.Enum.Category"]</label>
        <input class="form-control" id="Category" name="Category" value="@Model.Category"
               placeholder="geo_division.kind" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary">@Localizer["Common.Filter"]</button>
    </div>
</form>

<div class="card" aria-labelledby="enum-list-title">
    <div class="card-header">
    <h2 class="card-title" id="enum-list-title">@Localizer["Enums.Title"] <span class="badge bg-secondary-lt">@Model.Items.Count</span></h2>
</div>

    @if (Model.Items.Count == 0 && string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="empty">
            <span class="empty-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
                    <path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h7" />
                </svg>
            </span>
            <p class="empty-title">@Localizer["Enums.Empty"]</p>
            <a class="btn btn-primary btn-sm" asp-page="/Enums/Create" asp-route-category="@Model.Category">@Localizer["Enums.Create"]</a>
        </div>
    }
    else if (Model.Items.Count > 0)
    {
        <div class="table-responsive" tabindex="0" role="region" aria-labelledby="enum-list-title">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Field.Enum.Category"]</th>
                        <th scope="col">@Localizer["Field.Enum.Code"]</th>
                        <th scope="col">@Localizer["Field.Enum.Name"]</th>
                        <th scope="col">@Localizer["Field.Enum.SortOrder"]</th>
                        <th scope="col" class="text-end">@Localizer["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><code>@item.Category</code></td>
                            <td><code>@item.Code</code></td>
                            <td>@item.Name</td>
                            <td class="cell-num">@item.SortOrder</td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn btn-ghost" asp-page="/Enums/Edit" asp-route-id="@item.Id">@Localizer["Common.Edit"]</a>
                                    <a class="btn btn-ghost" asp-page="/Enums/Translations" asp-route-id="@item.Id">@Localizer["Translations.Manage"]</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline"
                                          data-confirm="@string.Format(Localizer["Enums.DeleteConfirm"].Value, item.Name)" data-confirm-button="@Localizer["Common.ConfirmDelete"]">
                                        <input type="hidden" name="Category" value="@Model.Category" />
                                        <button type="submit" class="btn btn-ghost btn-ghost-danger">@Localizer["Common.Delete"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
