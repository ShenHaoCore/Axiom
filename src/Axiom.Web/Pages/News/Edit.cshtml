@page
@model Axiom.Web.Pages.News.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? Localizer["News.Edit.EditTitle"].Value : Localizer["News.Edit.CreateTitle"].Value;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/News/Index">@Localizer["News.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header-main">
        <h1>@ViewData["Title"]</h1>
        <p class="page-description">@Localizer["News.Edit.Description"]</p>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="post" class="card form-card">
    <input type="hidden" asp-for="ArticleId" />
    <input type="hidden" asp-for="ETag" />

    <div class="form-section">
        <div class="section-heading">
            <h2>@Localizer["News.Section.Meta"]</h2>
            <p>@Localizer["News.Section.MetaHint"]</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Input.Title" class="form-label">
                    @Localizer["Field.News.Title"]<span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Category" class="form-label">
                    @Localizer["Field.News.Category"]<span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Input.Category" class="form-control" />
                <span asp-validation-for="Input.Category" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Author" class="form-label">
                    @Localizer["Field.News.Author"]<span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Input.Author" class="form-control" />
                <span asp-validation-for="Input.Author" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" class="form-select">
                    <option value="Draft">@Localizer["News.Status.Draft"]</option>
                    <option value="Published">@Localizer["News.Status.Published"]</option>
                    <option value="Archived">@Localizer["News.Status.Archived"]</option>
                </select>
                <span asp-validation-for="Input.Status" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Summary" class="form-label"></label>
                <input asp-for="Input.Summary" class="form-control" />
                <div class="form-text">@Localizer["News.Edit.SummaryHint"]</div>
                <span asp-validation-for="Input.Summary" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="section-heading">
            <h2>@Localizer["News.Section.Content"]</h2>
            <p>@Localizer["News.Edit.ContentHint"]</p>
        </div>
        <label asp-for="Input.Content" class="form-label">
            @Localizer["Field.News.Content"]<span class="required-mark" aria-hidden="true">*</span>
        </label>
        <textarea asp-for="Input.Content" class="form-control" rows="12"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>

    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="TranslationsLoaded" />

        @if (Model.TranslationsLoaded)
        {
            <div class="form-section">
                <div class="section-heading">
                    <h2>@Localizer["Translations.Title"]</h2>
                    <p>@Localizer["Translations.Hint"]</p>
                </div>

                <partial name="_TranslationEditor" model="Model.TranslationEditor" />
            </div>
        }
    }

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="/News/Index">@Localizer["Common.Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
