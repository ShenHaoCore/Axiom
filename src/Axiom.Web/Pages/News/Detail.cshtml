@page
@model Axiom.Web.Pages.News.DetailModel
@{
    ViewData["Title"] = Model.Article?.Title ?? Localizer["News.Detail.Title"];
    var articleTitle = Model.Article?.Title ?? string.Empty;
    var deleteConfirm = string.Format(Localizer["News.Detail.DeleteConfirm"].Value, articleTitle);
    var confirmButton = Localizer["Common.ConfirmDelete"].Value;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/News/Index">@Localizer["News.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

@if (Model.Article is { } article)
{
    <div class="page-header d-print-none">
    <div class="row align-items-center g-2">
        <div class="col">
            <div class="page-title">@article.Title</div>
            <div class="page-subtitle text-secondary">
                <span class="badge-soft status-@article.Status.ToString().ToLowerInvariant()">@Localizer[$"News.Status.{article.Status}"]</span>
                <span class="ms-2">@article.Category</span>
                <span class="text-muted">· @article.Author</span>
                <span class="text-muted">· @(article.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? Localizer["News.Detail.Unpublished"].Value)</span>
            </div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
            <a class="btn btn-outline-secondary" asp-page="/News/Index">@Localizer["Common.BackToList"]</a>
            <a class="btn btn-primary" asp-page="/News/Edit" asp-route-id="@article.Id">@Localizer["Common.Edit"]</a>
        </div>
        </div>
    </div>
</div>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-8 d-flex flex-column gap-3">
            <div class="card">
                <div class="card-header">@Localizer["News.Detail.Article"]</div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(article.Summary))
                    {
                        <p class="article-summary">@article.Summary</p>
                    }
                    <div class="article-content @(string.IsNullOrWhiteSpace(article.Summary) ? "" : "mt-4")">@article.Content</div>
                </div>
            </div>
        </div>

        <aside class="col-12 col-lg-4 d-flex flex-column gap-3">
            <div class="card">
                <div class="card-header">@Localizer["News.Detail.Meta"]</div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">@Localizer["News.Column.Status"]</div>
                            <div class="datagrid-content">
                                <span class="badge-soft status-@article.Status.ToString().ToLowerInvariant()">@Localizer[$"News.Status.{article.Status}"]</span>
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">@Localizer["News.Column.Category"]</div>
                            <div class="datagrid-content">@article.Category</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">@Localizer["News.Column.Author"]</div>
                            <div class="datagrid-content">@article.Author</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">@Localizer["News.Column.PublishedAt"]</div>
                            <div class="datagrid-content num">@(article.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? Localizer["News.Detail.Unpublished"].Value)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card danger-zone">
                <div class="card-header">@Localizer["Common.DangerZone"]</div>
                <div class="card-body">
                    <p class="danger-zone-text">@Localizer["Common.DeleteWarning"]</p>
                    <form method="post" asp-page-handler="Delete" data-confirm="@deleteConfirm" data-confirm-button="@confirmButton">
                        <input type="hidden" name="ArticleId" value="@article.Id" />
                        <input type="hidden" name="ETag" value="@Model.ETag" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Common.Delete"]</button>
                    </form>
                </div>
            </div>
        </aside>
    </div>
}
