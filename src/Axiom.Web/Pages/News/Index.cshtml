@page
@model Axiom.Web.Pages.News.IndexModel
@{
    ViewData["Title"] = Localizer["News.Title"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@Localizer["News.Title"]</h1>
    <a class="btn btn-primary" asp-page="/News/Edit">@Localizer["News.New"]</a>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="status">@Localizer["News.Column.Status"]</label>
        <select class="form-select" id="status" name="status">
            <option value="">@Localizer["News.Status.All"]</option>
            <option value="Draft" selected="@(Model.StatusFilter == "Draft")">@Localizer["News.Status.Draft"]</option>
            <option value="Published" selected="@(Model.StatusFilter == "Published")">@Localizer["News.Status.Published"]</option>
            <option value="Archived" selected="@(Model.StatusFilter == "Archived")">@Localizer["News.Status.Archived"]</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">@Localizer["Common.Filter"]</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">@Localizer["News.Column.Title"]</th>
                <th scope="col">@Localizer["News.Column.Category"]</th>
                <th scope="col">@Localizer["News.Column.Status"]</th>
                <th scope="col">@Localizer["News.Column.Author"]</th>
                <th scope="col">@Localizer["News.Column.PublishedAt"]</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model.Articles)
            {
                <tr>
                    <td>@article.Title</td>
                    <td>@article.Category</td>
                    <td>@Localizer[$"News.Status.{article.Status}"]</td>
                    <td>@article.Author</td>
                    <td>@(article.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/News/Detail" asp-route-id="@article.Id">@Localizer["Common.View"]</a>
                    </td>
                </tr>
            }
            @if (Model.Articles.Count == 0)
            {
                <tr><td colspan="6">@Localizer["News.Empty"]</td></tr>
            }
        </tbody>
    </table>
</div>

<p class="text-muted">@Localizer["Common.TotalCount", Model.TotalCount]</p>
