@page
@model Axiom.Web.Pages.News.IndexModel
@{
    ViewData["Title"] = Localizer["News.Title"];
}

<div class="page-header d-print-none">
    <div class="row align-items-center g-2">
        <div class="col">
            <div class="page-title">@Localizer["News.Title"]</div>
            <div class="page-subtitle text-secondary">@Localizer["News.Description"]</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
        <a class="btn btn-primary" asp-page="/News/Edit">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M8 3v10M3 8h10" />
            </svg>
            @Localizer["News.New"]
        </a>
    </div>
        </div>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="mb-3 filter-chips" role="group" aria-label="@Localizer["News.Column.Status"]">
    <a class="filter-chip @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")"
       asp-page="/News/Index" aria-current="@(string.IsNullOrEmpty(Model.StatusFilter) ? "page" : null)">@Localizer["News.Status.All"]</a>
    <a class="filter-chip @(Model.StatusFilter == "Draft" ? "active" : "")"
       asp-page="/News/Index" asp-route-status="Draft" aria-current="@(Model.StatusFilter == "Draft" ? "page" : null)">@Localizer["News.Status.Draft"]</a>
    <a class="filter-chip @(Model.StatusFilter == "Published" ? "active" : "")"
       asp-page="/News/Index" asp-route-status="Published" aria-current="@(Model.StatusFilter == "Published" ? "page" : null)">@Localizer["News.Status.Published"]</a>
    <a class="filter-chip @(Model.StatusFilter == "Archived" ? "active" : "")"
       asp-page="/News/Index" asp-route-status="Archived" aria-current="@(Model.StatusFilter == "Archived" ? "page" : null)">@Localizer["News.Status.Archived"]</a>
</div>

<div class="card" aria-labelledby="news-list-title">
    <div class="card-header">
    <h2 class="card-title" id="news-list-title">@Localizer["News.Title"] <span class="badge bg-secondary-lt">@Model.TotalCount</span></h2>
</div>

    @if (Model.Articles.Count == 0)
    {
        @* 筛选无结果与真正无内容是两种状态：前者给“清除筛选”出口。 *@
        <div class="empty">
            <span class="empty-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
                    <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
                    <path d="M4.5 6h4.5M4.5 8.5h7M4.5 11h7" />
                </svg>
            </span>
            @if (Model.StatusFilter is not null)
            {
                <p class="empty-title">@Localizer["News.FilteredEmpty"]</p>
                <p class="empty-subtitle text-secondary">@Localizer["News.FilteredEmptyHint", Model.StatusFilter]</p>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/News/Index">@Localizer["News.Status.All"]</a>
            }
            else
            {
                <p class="empty-title">@Localizer["News.Empty"]</p>
                <p class="empty-subtitle text-secondary">@Localizer["News.EmptyHint"]</p>
                <a class="btn btn-primary btn-sm" asp-page="/News/Edit">@Localizer["News.New"]</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive" tabindex="0" role="region" aria-labelledby="news-list-title">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["News.Column.Title"]</th>
                        <th scope="col">@Localizer["News.Column.Category"]</th>
                        <th scope="col">@Localizer["News.Column.Status"]</th>
                        <th scope="col">@Localizer["News.Column.Author"]</th>
                        <th scope="col">@Localizer["News.Column.PublishedAt"]</th>
                        <th scope="col" class="text-end">@Localizer["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Model.Articles)
                    {
                        <tr>
                            <td>@article.Title</td>
                            <td class="cell-muted text-nowrap">@article.Category</td>
                            <td><span class="badge-soft status-@article.Status.ToString().ToLowerInvariant()">@Localizer[$"News.Status.{article.Status}"]</span></td>
                            <td class="cell-muted">@article.Author</td>
                            <td class="cell-num">@(article.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn btn-ghost" asp-page="/News/Detail" asp-route-id="@article.Id">@Localizer["Common.View"]</a>
                                    <a class="btn btn-ghost" asp-page="/News/Edit" asp-route-id="@article.Id">@Localizer["Common.Edit"]</a>
                                    <a class="btn btn-ghost" asp-page="/News/Translations" asp-route-id="@article.Id">@Localizer["Translations.Manage"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="@Localizer["Common.Pager.Label"]">
                <ul class="pagination m-0">
                    <li class="page-item @(Model.CurrentPage > 1 ? "" : "disabled")">
                        <a class="page-link" asp-page="/News/Index" asp-route-status="@Model.StatusFilter"
                           asp-route-page="@(Model.CurrentPage - 1)" tabindex="@(Model.CurrentPage > 1 ? null : -1)"
                           aria-disabled="@(Model.CurrentPage > 1 ? null : "true")">@Localizer["Common.Pager.Previous"]</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@Localizer["Common.Pager.PageOf", Model.CurrentPage, Model.TotalPages]</span></li>
                    <li class="page-item @(Model.CurrentPage < Model.TotalPages ? "" : "disabled")">
                        <a class="page-link" asp-page="/News/Index" asp-route-status="@Model.StatusFilter"
                           asp-route-page="@(Model.CurrentPage + 1)" tabindex="@(Model.CurrentPage < Model.TotalPages ? null : -1)"
                           aria-disabled="@(Model.CurrentPage < Model.TotalPages ? null : "true")">@Localizer["Common.Pager.Next"]</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
