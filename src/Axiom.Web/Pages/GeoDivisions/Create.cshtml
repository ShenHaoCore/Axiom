@page
@model Axiom.Web.Pages.GeoDivisions.CreateModel
@{
    ViewData["Title"] = Localizer["GeoDivisions.Create.Title"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/GeoDivisions/Index">@Localizer["GeoDivisions.Title"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["GeoDivisions.Create.Title"]</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header-main">
        <h1>@Localizer["GeoDivisions.Create.Title"]</h1>
        <p class="page-description">@Localizer["GeoDivisions.Create.Description"]</p>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@* 国家/父级变更走 GET 刷新层级与 Kind；用 form 属性挂到本表单，避免触发下方 POST。 *@
<form id="region-create-reload" method="get" data-no-loading>
    <noscript>
        <button type="submit" class="btn btn-outline-primary mb-3">@Localizer["GeoDivisions.Create.LoadForm"]</button>
    </noscript>
</form>

<form method="post" class="card form-card" id="region-create-form">
    <input type="hidden" asp-for="Input.Level" />
    <input type="hidden" asp-for="Input.ParentId" />
    @if (Model.Input.Level > 1)
    {
        <input type="hidden" asp-for="Input.CountryCode" />
    }

    <div class="form-section">
        <div class="section-heading">
            <h2>@Localizer["GeoDivisions.Section.Identity"]</h2>
            <p>@Localizer["GeoDivisions.Create.SetupHint"]</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.Kind" class="form-label"></label>
                <select asp-for="Input.Kind" class="form-select" asp-items="Model.KindOptions"></select>
                <span asp-validation-for="Input.Kind" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="region-country-code">@Localizer["Field.GeoDivision.CountryCode"]</label>
                @if (Model.Input.Level == 1)
                {
                    @* 新建国家：自由输入 ISO 代码；datalist 仅提示已有国家。改完 2 位后 GET 刷新 Kind/父级树。 *@
                    <input asp-for="Input.CountryCode"
                           class="form-control text-uppercase"
                           id="region-country-code"
                           maxlength="2"
                           autocomplete="off"
                           list="region-country-code-list"
                           placeholder="CN"
                           data-reload-country />
                    <datalist id="region-country-code-list">
                        @foreach (var country in Model.Countries)
                        {
                            <option value="@country.CountryCode">@country.Name</option>
                        }
                    </datalist>
                    <div class="form-text">@Localizer["GeoDivisions.Hint.CountryCode"]</div>
                    <span asp-validation-for="Input.CountryCode" class="text-danger"></span>
                }
                else
                {
                    <input class="form-control" id="region-country-code" value="@Model.Input.CountryCode" readonly />
                }
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="region-parent-toggle">
                    @Localizer["Field.GeoDivision.Parent"]
                    @if (Model.Input.Level > 1)
                    {
                        <span class="required-mark" aria-hidden="true">*</span>
                    }
                </label>
                @{
                    var parentSelect = new Axiom.Web.Models.ParentTreeSelectViewModel
                    {
                        InputId = "region-parent",
                        InputName = "parentId",
                        FormId = "region-create-reload",
                        AutoSubmit = true,
                        EmptyLabel = Localizer["GeoDivisions.Form.SelectParent"].Value,
                        SearchPlaceholder = Localizer["GeoDivisions.Form.SearchParent"].Value,
                        SelectedId = Model.Input.ParentId,
                        SelectedLabel = Model.Input.ParentId is Guid createParentId
                            ? (Axiom.Web.Models.ParentTreeSelectViewModel.FindLabel(Model.ParentTree, createParentId) ?? string.Empty)
                            : string.Empty,
                        Nodes = Model.ParentTree
                    };
                }
                <partial name="_ParentTreeSelect" model="parentSelect" />
                @if (Model.Input.Level > 1)
                {
                    <span asp-validation-for="Input.ParentId" class="text-danger"></span>
                }
            </div>
            @if (Model.Input.Level > 1)
            {
                <div class="col-md-6">
                    <label asp-for="Input.SubdivisionCode" class="form-label"></label>
                    <input asp-for="Input.SubdivisionCode" class="form-control" autocomplete="off" />
                    <div class="form-text">@Localizer["GeoDivisions.Hint.SubdivisionCode"]</div>
                    <span asp-validation-for="Input.SubdivisionCode" class="text-danger"></span>
                </div>
            }

            <div class="col-md-6">
                <label asp-for="Input.Name" class="form-label">
                    @Localizer["Field.GeoDivision.Name"]<span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.AsciiName" class="form-label"></label>
                <input asp-for="Input.AsciiName" class="form-control" />
                <span asp-validation-for="Input.AsciiName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.LocalName" class="form-label"></label>
                <input asp-for="Input.LocalName" class="form-control" />
                <span asp-validation-for="Input.LocalName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="section-heading">
            <h2>@Localizer["GeoDivisions.Section.Geo"]</h2>
            <p>@Localizer["GeoDivisions.Section.GeoHint"]</p>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.Latitude" class="form-label"></label>
                <input asp-for="Input.Latitude" class="form-control" step="any" />
                <span asp-validation-for="Input.Latitude" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Longitude" class="form-label"></label>
                <input asp-for="Input.Longitude" class="form-control" step="any" />
                <span asp-validation-for="Input.Longitude" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Population" class="form-label"></label>
                <input asp-for="Input.Population" class="form-control" min="0" />
                <span asp-validation-for="Input.Population" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="/GeoDivisions/Index"
           asp-route-countryCode="@Model.Input.CountryCode">@Localizer["Common.Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
