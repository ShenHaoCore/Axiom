{
  "ConnectionStrings": {
    "Auth": "Host=localhost;Port=5432;Database=axiom_auth;Username=axiom"
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5101"
  },
  "Oidc": {
    "Clients": [
      {
        "ClientId": "axiom-web",
        "DisplayName": "Axiom Web",
        "RedirectUris": [ "http://localhost:3000/callback" ]
      },
      {
        "ClientId": "axiom-bff",
        "DisplayName": "Axiom BFF",
        "RedirectUris": [ "http://localhost:3002/bff/signin-oidc", "http://localhost:3003/bff/signin-oidc", "http://localhost:5200/bff/signin-oidc" ]
      }
    ]
  },
  "SeedUser": {
    "UserName": "demo@axiom.local"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
