{
  "ConnectionStrings": {
    "Auth": "Host=localhost;Port=5432;Database=axiom_auth;Username=axiom"
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5101"
  },
  "Oidc": {
    "Clients": [
      {
        "ClientId": "axiom-web",
        "DisplayName": "Axiom Web",
        "RedirectUris": [ "http://localhost:3000/callback" ]
      }
    ]
  },
  "SeedUser": {
    "UserName": "demo@axiom.local"
  },
  "Localization": {
    "DefaultCulture": "zh-CN",
    "SupportedCultures": [ "zh-CN", "en" ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
