{
  "Authentication": {
    "Authority": "http://localhost:5101",
    "ValidIssuer": "http://localhost:5101"
  },
  "ReferenceDataGrpc": {
    "Address": "http://localhost:5103"
  },
  "Localization": {
    "DefaultCulture": "zh-CN",
    "SupportedCultures": [ "zh-CN", "en" ]
  },
  "ReverseProxy": {
    "Routes": {
      "reference-data": {
        "ClusterId": "reference-data",
        "Match": {
          "Path": "/api/reference-data/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/reference-data/{**catch-all}" }
        ]
      },
      "news": {
        "ClusterId": "news",
        "Match": {
          "Path": "/api/news/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/news/{**catch-all}" }
        ]
      },
      "regions": {
        "ClusterId": "reference-data",
        "Match": {
          "Path": "/api/regions/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/regions/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "reference-data": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "news": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104"
          }
        }
      }
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
