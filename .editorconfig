# Axiom 统一风格约定：dotnet format 与 EnforceCodeStyleInBuild 依据本文件执行。
# 分级说明：警告=偏离需修，建议=尽量遵循。保持与现有代码风格（中文注释、显式访问修饰符）一致。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,resx}]
indent_size = 2

[*.cs]
indent_size = 4

# CA1707 禁止标识符下划线：与仓库既定的 SCREAMING_SNAKE_CASE 常量约定
# （ApiErrorCodes、EventTypes 等对外契约键）冲突，整体豁免。
dotnet_diagnostic.CA1707.severity = none

# CA1711 类型名不应以 Enum 结尾：ReferenceEnum（枚举字典）是领域概念命名，故意保留。
dotnet_diagnostic.CA1711.severity = none

# CA1848/CA1873 要求 LoggerMessage 源生成委托：仓库统一使用 ILogger 扩展方法直调，
# 日志量级与延迟目标不需要源生成优化，迁移 60+ 调用点无功能收益，整体豁免。
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# EF 迁移文件由工具生成：不做风格/性能检查（避免每次迁移生成都被质量门拦截）。
[**/Migrations/*.cs]
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1819.severity = none

# 测试代码：放宽与正确性无关的风格/性能规则（断言可读性优先）。
# EF Core 查询必须用 ToLower（可翻译为 SQL LOWER）；ToLowerInvariant 无 SQL 翻译，
# 会在 PostgreSQL 上抛 500（本仓库 CI 才跑真实 PG，本地 InMemory 不可见）。
[**/EfCore/*.cs]
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1304.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA2263.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1862.severity = none

# ---------- C# 风格（IDE 前缀） ----------

# 变量声明偏好：保持显式类型（仓库现状），var 仅在类型明显时允许。
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# 访问修饰符：与现有代码一致，非接口成员全部显式标注；接口成员按惯例省略 public。
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# this. 与限定符
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# 语言偏好
dotnet_style_object_initializer = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning

# using 指令：System 优先（现有排序习惯）
dotnet_sort_system_directives_first = true

# ---------- 命名规则 ----------

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_rule.types_and_members_pascal.severity = warning
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,enum,method,property,event
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_camel.severity = suggestion
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = camel_case_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore.required_prefix = _
dotnet_naming_style.camel_case_underscore.capitalization = camel_case
