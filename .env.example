# 开发环境变量示例：复制为 .env 后填写本地密码。
POSTGRES_PASSWORD=replace-with-a-local-password
DEMO_USER_PASSWORD=replace-with-a-demo-password
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password

# 开发环境默认值，通常无需修改
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_AUTH_ISSUER=http://localhost:5101/
PUBLIC_WEB_CALLBACK_URL=http://localhost:3000/callback
PUBLIC_BFF_CALLBACK_URL=http://localhost:3002/bff/signin-oidc
INTERNAL_AUTH_URL=http://authhub:8080
INTERNAL_GATEWAY_URL=http://gateway:8080
AUTH_REQUIRE_HTTPS_METADATA=false
OTLP_ENDPOINT=http://otel-collector:4317

# 端口被占用时取消注释并调整
# AUTHHUB_PORT=5101
# GATEWAY_PORT=5100
# NEWS_PORT=5104
# WEB_PORT=3000
# BFF_PORT=3002
