<Project>

  <!-- 版本号唯一来源：发版时在 release/* 分支修改此处，与 Release Drafter 生成的 v<版本号> tag 保持一致。 -->
  <PropertyGroup>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <!-- 编译期质量门：警告即失败、内置分析器、代码风格在构建期强制（规则细则见根 .editorconfig）。 -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- NuGet Audit：传递包 System.Security.Cryptography.Pkcs/Xml 10.0.11 的 5 条已知漏洞
       暂无修补版本（GitHub Advisory patched=null，等待 .NET 10 服务补丁）。因
       TreatWarningsAsErrors 会升级为 NU1902/NU1903 错误，此处显式压制；
       修补版本发布后应移除本块并升级依赖。 -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-r955-8q5j-3h83" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c399-9853-6jmj" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7hqp-7c5m-4vq6" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
  </ItemGroup>

</Project>
